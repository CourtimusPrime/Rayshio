{
  "name": "web",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "typecheck": "tsc --noEmit",
    "bones": "boneyard-js build \"http://localhost:5301/?bones=1\" --out ./src/bones --breakpoints 390,768,1440 --wait 3000 --force",
    "dev:slow": "BONES_SLOW=30000 vite --port 5301 --strictPort",
    "preview": "vite preview"
  },
  "dependencies": {
    "@lobehub/icons-static-svg": "^1.94.0",
    "@tanstack/react-query": "^5.62.7",
    "better-auth": "^1.6.25",
    "boneyard-js": "^1.9.0",
    "date-fns": "4.1.0",
    "framer-motion": "11.18.2",
    "lucide-react": "0.577.0",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "react-router-dom": "6.30.2",
    "recharts": "2.15.0",
    "tailwind-merge": "2.6.1"
  },
  "devDependencies": {
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.4.20",
    "postcss": "^8.4.49",
    "react-scan": "^0.5.7",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.8.3",
    "vite": "^6.0.5"
  }

# Google OAuth — one client for both jobs
#
# Gmail ingestion asks for gmail.readonly; sign-in asks for openid/email/profile.
# Scopes are per authorization request, not per client, so a plain login never
# shows a mailbox-access consent screen and a second client buys nothing.
#
# The app is an *internal* Google Workspace app, which is what restricts who may
# sign in — there is no allowlist in this file, deliberately.
#
# Redirect URIs to register on the client:
#   <VITE_PUBLIC_ORIGIN>/api/auth/callback/google   (sign-in)
#   <VITE_PUBLIC_ORIGIN>/oauth/callback             (Gmail connect)
#
# Scopes requested at connect: gmail.readonly to ingest invoices, and gmail.send
# to email them to an accountant from the user's own mailbox. Both are
# restricted, so both must be declared on the OAuth consent screen; a mailbox
# connected before gmail.send was added keeps working for ingestion and cannot
# send until it is reconnected.
GOOGLE_CLIENT_ID=...
GOOGLE_CLIENT_SECRET=...

# Database Connection strings
PGSQL_DATABASE_URL=...
MONGODB_DATABASE_URL=...
REDIS_DATABASE_URL=...

# AI (OpenRouter)
OPENROUTER_API_KEY=...
# OPENROUTER_CLASSIFY_MODEL=google/gemini-2.5-flash-lite
# OPENROUTER_EXTRACT_MODEL=google/gemini-2.5-flash
# OPENROUTER_ESCALATE_MODEL=openai/gpt-4.1

# Secrets
# 32 bytes base64: openssl rand -base64 32
TOKEN_ENCRYPTION_KEY=...
# MCP client auth: openssl rand -hex 24
MCP_API_KEY=...
# Signs Better Auth sessions, and the Gmail connect `state`. 32+ chars:
# openssl rand -base64 32
BETTER_AUTH_SECRET=...

# The one origin the app is served from.
#
# Everything public is derived from it: Better Auth's baseURL, the Gmail OAuth
# callback (<origin>/oauth/callback) and the MCP endpoint shown on the dashboard
# (<origin>/mcp). Moving to a new host is this one variable.
#
# Named VITE_ because the SPA build reads the same value for index.html, robots.txt
# and sitemap.xml, which need an absolute URL baked in.
VITE_PUBLIC_ORIGIN=http://localhost:3000

# Optional
# MCP_PORT=3000
# Org the legacy MCP_API_KEY fallback maps to; removed in R3
# MCP_LEGACY_KEY_ORG_ID=1
# SYNC_CRON=0 6 1 * *

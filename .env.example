# Google OAuth Credentials

GOOGLE_CLIENT_ID=...
GOOGLE_CLIENT_SECRET=...
GOOGLE_REDIRECT_URI=http://localhost:8787/oauth/callback

# Database Connection strings

PGSQL_DATABASE_URL=...
MONGODB_DATABASE_URL=...
REDIS_DATABASE_URL=...

# AI (OpenRouter)

OPENROUTER_API_KEY=...
# OPENROUTER_CLASSIFY_MODEL=google/gemini-2.5-flash-lite
# OPENROUTER_EXTRACT_MODEL=google/gemini-2.5-flash
# OPENROUTER_ESCALATE_MODEL=openai/gpt-4.1

# Secrets

# 32 bytes base64: openssl rand -base64 32
TOKEN_ENCRYPTION_KEY=...
# MCP client auth: openssl rand -hex 24
MCP_API_KEY=...

# Dashboard

# Shared password for the web dashboard (min 8 chars)
DASHBOARD_PASSWORD=...
# Signs the dashboard session cookie. 32 bytes base64: openssl rand -base64 32
DASHBOARD_SESSION_SECRET=...
# Shown on the dashboard's MCP page so users know where to point their client
PUBLIC_MCP_URL=http://localhost:3000/mcp

# Optional

# MCP_PORT=3000
# DEFAULT_ORG_ID=1
# SYNC_CRON=0 6 1 * *
# DASHBOARD_SESSION_TTL_HOURS=12

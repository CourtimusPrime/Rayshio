# Google OAuth — Gmail ingestion
#
# Carries gmail.readonly, a *restricted* scope. Sign-in deliberately does NOT
# reuse this client: sharing it would show a mailbox-access consent screen for
# a plain login. See AUTH_GOOGLE_* below.

GOOGLE_CLIENT_ID=...
GOOGLE_CLIENT_SECRET=...
GOOGLE_REDIRECT_URI=http://localhost:8787/oauth/callback

# Google OAuth — sign-in (a separate client, scopes: openid email profile)
#
# Redirect URIs to register:
#   https://<prod-host>/api/auth/callback/google
#   http://localhost:3000/api/auth/callback/google
#   http://localhost:5173/api/auth/callback/google   (Vite proxy, dev)

AUTH_GOOGLE_CLIENT_ID=...
AUTH_GOOGLE_CLIENT_SECRET=...

# Database Connection strings

PGSQL_DATABASE_URL=...
MONGODB_DATABASE_URL=...
REDIS_DATABASE_URL=...

# AI (OpenRouter)

OPENROUTER_API_KEY=...
# OPENROUTER_CLASSIFY_MODEL=google/gemini-2.5-flash-lite
# OPENROUTER_EXTRACT_MODEL=google/gemini-2.5-flash
# OPENROUTER_ESCALATE_MODEL=openai/gpt-4.1

# Secrets

# 32 bytes base64: openssl rand -base64 32
TOKEN_ENCRYPTION_KEY=...
# MCP client auth: openssl rand -hex 24
MCP_API_KEY=...

# Auth

# Signs Better Auth sessions. 32+ chars: openssl rand -base64 32
BETTER_AUTH_SECRET=...
# Origin the app is served from — Better Auth's baseURL and the OAuth callback host
PUBLIC_APP_URL=http://localhost:3000
# Comma-separated sign-up allowlist. An address outside it gets in only by
# holding a pending client.org_invitation.
# Empty or `*` opens registration to anyone with a Google account.
ALLOWED_SIGNUP_EMAILS=*

# Dashboard

# Legacy shared password. Removed in R2 — Google sign-in replaces it.
DASHBOARD_PASSWORD=...
# Signs the legacy dashboard cookie. 32 bytes base64: openssl rand -base64 32
DASHBOARD_SESSION_SECRET=...
# Shown on the dashboard's MCP page so users know where to point their client
PUBLIC_MCP_URL=http://localhost:3000/mcp

# Optional

# MCP_PORT=3000
# DEFAULT_ORG_ID=1
# Org the legacy MCP_API_KEY fallback maps to; removed in R3
# MCP_LEGACY_KEY_ORG_ID=1
# SYNC_CRON=0 6 1 * *
# DASHBOARD_SESSION_TTL_HOURS=12
